NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Correos masivos (resend.com → API Keys; dominio verificado) ──
RESEND_API_KEY=
EMAIL_FROM="Technosoftware <noreply@tudominio.com>"

# ── Solo para scripts/seed-admin.mjs ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Recargas de saldo con PayPal (developer.paypal.com → Apps & Credentials) ──
PAYPAL_ENV=sandbox            # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=            # id del webhook apuntando a /api/webhooks/paypal

# ── Asistente de IA (gratis primero; se usan en este orden si existen) ──
GOOGLE_GENERATIVE_AI_API_KEY=   # aistudio.google.com/apikey (gratis, sin tarjeta)
GROQ_API_KEY=                   # console.groq.com/keys (gratis, sin tarjeta) - respaldo
